# Optional standalone bootstrap: a NEW empty database on a dedicated PostgreSQL 16 cluster.
# Copy to .env and load it into your shell; the application does not auto-load .env.
FLEETOPS_BOOTSTRAP_URL=postgresql://postgres:replace-me@127.0.0.1:5432/fleetops
FLEETOPS_MIGRATOR_PASSWORD=replace-with-a-unique-password
FLEETOPS_APP_PASSWORD=replace-with-a-different-unique-password
FLEETOPS_MIGRATOR_URL=postgresql+psycopg://fleetops_migrator:replace-with-url-encoded-password@127.0.0.1:5432/fleetops
# Tests need no credentials or .env: they create a disposable Docker PostgreSQL 16 cluster.

# Slice 2 runtime: ordinary requests and the initial-user command use fleetops_app.
FLEETOPS_APP_URL=postgresql+psycopg://fleetops_app:replace-with-url-encoded-password@127.0.0.1:5432/fleetops
# Trusted single-org login/bootstrap configuration; never read from request data.
FLEETOPS_ORG_ID=01a0744a-17c4-7497-a69b-9da2aa8403da
FLEETOPS_SESSION_SECONDS=43200
# Supply these only when running the separate initial-user command. No real password here.
FLEETOPS_BOOTSTRAP_USERNAME=
FLEETOPS_BOOTSTRAP_PASSWORD=
